# Redraft frontend (Vite). Copy to .env.local to change defaults.

# "real" talks to the Django backend; leave unset (or "mock") for the in-app mock.
VITE_API_MODE=mock

# Base path for real API calls; the Vite dev server proxies this to Django.
VITE_API_BASE_URL=/api

# Show the "Continue with Google" button (the backend returns 501 until wired up).
VITE_ENABLE_GOOGLE_AUTH=false
