# Redraft production environment template.
# Copy to /etc/foxtutor/foxtutor.env, fill in the REPLACE_* values, then:
#   sudo chown foxtutor:foxtutor /etc/foxtutor/foxtutor.env
#   sudo chmod 600 /etc/foxtutor/foxtutor.env
# Never commit the filled-in file.

# --- Core ---
DEBUG=False
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Domain (HTTPS) or the instance public IP (HTTP demo). Comma-separated, no spaces.
ALLOWED_HOSTS=REPLACE_WITH_DOMAIN_OR_PUBLIC_IP
# Scheme + host exactly as the browser uses it (admin login CSRF).
# e.g. https://your.domain  OR  http://203.0.113.10
CSRF_TRUSTED_ORIGINS=REPLACE_WITH_SCHEME_AND_HOST

TIME_ZONE=UTC

# --- Data (single directory; back this up) ---
# Note the four slashes: scheme + absolute path.
DATABASE_URL=sqlite:////var/lib/foxtutor/db.sqlite3
MEDIA_ROOT=/var/lib/foxtutor/media

# --- HTTPS ---
# True for a domain + Let's Encrypt. False for the plain-HTTP IP demo.
USE_HTTPS=True
# Short initial HSTS window; lengthen once HTTPS is proven. 0 disables it.
SECURE_HSTS_SECONDS=3600

# --- Auth ---
TOKEN_TTL_DAYS=7

# --- Rate limits ---
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=10/hour
THROTTLE_AI=30/day

# --- AI provider ---
# none | anthropic | openai_compatible
AI_PROVIDER=openai_compatible
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Keep AI_TIMEOUT * (AI_MAX_RETRIES + 1) comfortably under Gunicorn's 120s timeout.
AI_TIMEOUT=30
AI_MAX_RETRIES=2
