# Copy to .env and adjust. Never commit .env.

# --- Core ---
# DEBUG defaults to OFF. The server refuses to start with DEBUG off unless a real
# SECRET_KEY is set (the dev placeholder is rejected too).
# For local development, set DEBUG=True (a dev-only secret is then allowed).
DEBUG=False
# Required when DEBUG is off. Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Left unset -> SQLite at backend/db.sqlite3. Set a Postgres URL to switch engines.
# DATABASE_URL=postgres://user:password@localhost:5432/foxtutor

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
TOKEN_TTL_DAYS=7

# --- Rate limits ---
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=10/hour
THROTTLE_AI=30/day

# --- AI provider ---
# AI_PROVIDER: none | anthropic | openai_compatible
# none (or a missing key) keeps the app fully usable offline (sample data only).
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# Required only for openai_compatible (Groq, OpenRouter, ...):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_TIMEOUT=30
# AI_MAX_RETRIES=2
