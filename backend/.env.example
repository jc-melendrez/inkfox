# Copy to .env and adjust. Never commit .env.

# --- Core ---
# DEBUG defaults to OFF. The server refuses to start with DEBUG off unless a real
# SECRET_KEY is set (the dev placeholder is rejected too).
# For local development, set DEBUG=True (a dev-only secret is then allowed).
DEBUG=False
# Required when DEBUG is off. Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins trusted for CSRF (admin login). e.g. https://your.domain
CSRF_TRUSTED_ORIGINS=

# --- Timezone ---
TIME_ZONE=UTC

# --- Database ---
# Left unset -> SQLite at backend/db.sqlite3. Set a Postgres URL to switch engines.
# DATABASE_URL=postgres://user:password@localhost:5432/foxtutor

# --- Uploads ---
# Left unset -> backend/media/private. Production points this at the data dir.
# MEDIA_ROOT=/var/lib/foxtutor/media

# --- HTTPS ---
# Defaults to "on when DEBUG is off". Set False for an IP-only plain-HTTP demo.
USE_HTTPS=True
# HSTS seconds (short at first, lengthen once HTTPS is proven). 0 disables it.
SECURE_HSTS_SECONDS=3600

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth ---
TOKEN_TTL_DAYS=7

# --- Rate limits ---
THROTTLE_LOGIN=10/min
THROTTLE_SIGNUP=10/hour
THROTTLE_AI=30/day

# --- AI provider ---
# AI_PROVIDER: none | anthropic | openai_compatible
# none (or a missing key) keeps the app fully usable offline (sample data only).
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# Required only for openai_compatible (Groq, OpenRouter, ...):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_TIMEOUT=30
# AI_MAX_RETRIES=2
